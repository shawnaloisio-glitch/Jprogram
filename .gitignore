# ============================================================
# Japanese Corpus Pipeline — Git repository boundary (.gitignore)
# Protects the repository from committing secrets, customer data,
# runtime artifacts, logs, user preferences, and developer residue.
# Product source (Python, tests, docs, prompts, templates, product
# Config JSON) is intentionally NOT ignored.
# ============================================================

# ---- Secrets --------------------------------------------------
api_key.txt
*api_key*.txt
*apikey*.txt
.env
.env.*
*.env

# ---- Customer workspace / runtime data -------------------------
Sources/
Source Registry/
Cleaning Jobs/
Cleaning Results/
Cleaned Archive/
Processing Results/
Data Processor/jobs/
Data Processor/requests/
Data Processor/responses/
Data Processor/jsonl/
Data Processor/processing/
Data Processor/completed/
Data Processor/failed/
Data Processor/indexes/
Data Processor/Job Results/
Data Processor/Request Results/
Data Processor/Corpus Results/
Analysis/outputs/
Diagnostics/
Intake/

# ---- Runtime logs (preserve the README only) -------------------
Logs/*
!Logs/README.md

# ---- User preference / runtime files ---------------------------
Source Builder/gui_settings.json
Source Builder/quick_presets.json

# ---- Developer artifacts ---------------------------------------
Config/*.bak
__pycache__/
**/__pycache__/
*.pyc
*.pyo

# ---- Web UI runtime data (ephemeral form submissions) -----------
Web UI/pending_submission.json
Web UI/submission_archive/
Web UI/server.log

# ---- Project-local virtual environment --------------------------
.venv/

# ---- Local agent/tool state (machine-specific, not source) ------
.reasonix/
reasonix.toml

# ---- Language Coach J: regenerable analysis output --------------
Language Coach J/tools/analysis/outputs/
Language Coach J/tools/analysis/library.db
